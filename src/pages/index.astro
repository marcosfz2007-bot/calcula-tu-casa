---
import Base from '../layouts/Base.astro';
import HeroSearch from '../components/HeroSearch.astro';
import HomeHeroVisual from '../components/HomeHeroVisual.astro';
import ToolCard from '../components/ToolCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import {tools,categories,toolByPath} from '../lib/catalog.mjs';
const featuredPaths=['climatizacion/calculadora-frigorias','energia/simulador-factura-electrica','solar/numero-placas-solares','reformas/presupuesto-reforma-integral'];
const featured=featuredPaths.map(path=>toolByPath.get(path)).filter(Boolean);
const publishedCount=tools.length;
---
<Base title="Calculadoras para hogar, energía, climatización y aislamiento" description="Calcula primero y decide después: herramientas gratuitas, sin registro, con fórmulas, fuentes y procesamiento transparente.">
  <section class="home-hero-v2">
    <div class="home-hero-copy">
      <p class="eyebrow">TU HOGAR, CON LAS CUENTAS CLARAS</p>
      <h1>Calcula primero.<br/>Decide después.</h1>
      <p class="lead">Descubre cuánto necesitas, cuánto gastas y cuánto puedes ahorrar en tu casa. Calculadoras gratuitas, inmediatas y sin registro.</p>
      <HeroSearch tools={tools}/>
      <span class="sr-only">{publishedCount} calculadoras publicadas.</span>
      <div class="home-trust"><span>Gratis</span><span>Sin registro</span><span>Resultado inmediato</span><span>Metodología y fuentes visibles</span></div>
    </div>
    <HomeHeroVisual/>
  </section>

  <section class="section home-featured">
    <div class="section-head"><div><p class="eyebrow">EMPIEZA POR UNA DECISIÓN</p><h2>¿Qué quieres resolver hoy?</h2></div><p class="muted">Las herramientas se presentan por el problema que ayudan a resolver y por el resultado que obtendrás.</p></div>
    <div class="grid featured-grid">{featured.map(tool=><ToolCard tool={tool}/>)}</div>
  </section>

  <section class="section">
    <div class="section-head"><div><p class="eyebrow">EXPLORA POR TEMA</p><h2>Cinco áreas, una misma forma de decidir</h2></div><p class="muted">El color te ayuda a orientarte sin romper la identidad común de Calcula tu Casa.</p></div>
    <div class="category-grid">{categories.map(category=><CategoryCard category={category} count={tools.filter(tool=>tool.categorySlug===category.slug).length}/>)}</div>
  </section>

  <section class="home-how">
    <div class="home-how-intro"><p class="eyebrow">TRANSPARENCIA ANTES QUE PROMESAS</p><h2>Un resultado útil porque puedes entender de dónde sale.</h2></div>
    <div class="steps">
      <div><span>01</span><strong>Introduce tus datos</strong><p class="muted">Utiliza medidas, potencias, precios o datos de producto cuando proceda.</p></div>
      <div><span>02</span><strong>Entiende el resultado</strong><p class="muted">La cifra principal se acompaña de desglose, hipótesis y límites cuando aportan contexto.</p></div>
      <div><span>03</span><strong>Resuelve la siguiente decisión</strong><p class="muted">Continúa con otra calculadora únicamente cuando exista una relación lógica.</p></div>
    </div>
  </section>
</Base>