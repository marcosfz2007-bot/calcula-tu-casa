---
import Base from '../layouts/Base.astro';
import SearchTools from '../components/SearchTools.astro';
import {tools} from '../lib/catalog.mjs';
---
<Base title="Calculadoras para hogar, energía, climatización y aislamiento" description="Calcula primero y decide después: herramientas gratuitas, sin registro, con fórmulas, fuentes y procesamiento transparente."><section class="hero"><p class="eyebrow">TU HOGAR, CON LAS CUENTAS CLARAS</p><h1>Calcula primero.<br/>Decide después.</h1><p class="lead">Herramientas para estimar consumo, factura, potencia, climatización, ventilación, solar, agua caliente y aislamiento. Sin registro, sin llamadas y con la metodología visible.</p><a class="button" href="#herramientas">Encontrar una calculadora</a><div class="mt-6"><span class="badge">{tools.length} calculadoras</span><span class="badge">Procesamiento transparente</span><span class="badge">Sin teléfono</span><span class="badge">Fórmulas transparentes</span></div></section><section id="herramientas" class="section"><p class="eyebrow">EMPIEZA POR UNA PREGUNTA</p><h2>¿Qué quieres calcular?</h2><SearchTools tools={tools}/></section><section class="how"><div class="steps"><div><strong>01 · Introduce tus datos</strong><p class="muted">Usa la etiqueta de tus equipos o las medidas de tu vivienda cuando proceda.</p></div><div><strong>02 · Revisa las hipótesis</strong><p class="muted">Los factores orientativos se identifican y no se presentan como datos universales.</p></div><div><strong>03 · Sigue el siguiente cálculo</strong><p class="muted">Las herramientas se enlazan según la siguiente decisión natural.</p></div></div></section></Base>