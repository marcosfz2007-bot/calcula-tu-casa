---
import Base from '../layouts/Base.astro';
import {infoPages,tools} from '../lib/catalog.mjs';
export function getStaticPaths(){return infoPages.map(info=>({params:{info}}));}
const info=Astro.params.info;
const email=import.meta.env.PUBLIC_CONTACT_EMAIL?.trim();
const owner=import.meta.env.LEGAL_OWNER_NAME?.trim();
const nif=import.meta.env.LEGAL_NIF?.trim();
const address=import.meta.env.LEGAL_ADDRESS?.trim();
const siteUrl=import.meta.env.SITE_URL?.trim();
const domain=siteUrl?new URL(siteUrl).hostname:'';
const legalReady=Boolean(owner&&nif&&address&&email&&domain);
const legalIdentity=legalReady?`Titular: ${owner} · NIF: ${nif} · Domicilio: ${address} · Email: ${email} · Sitio: ${domain}.`:'Los datos de identificación legal todavía no están completos en este entorno.';
const pages={
'sobre-nosotros':{title:'Sobre el proyecto',intro:'Calcula tu casa es un sitio de herramientas para tomar decisiones domésticas a partir de cálculos transparentes.',body:['El sitio publica doce calculadoras: las ocho herramientas iniciales y cuatro nuevas para suelo radiante, ventilación CTE, simulación de factura eléctrica y producción fotovoltaica con PVGIS.','No presentamos autores, titulaciones o revisores inventados. La confianza se apoya en fórmulas visibles, fuentes, hipótesis, límites, versiones metodológicas y pruebas automatizadas.','El objetivo es que el resultado aparezca sin registro, teléfono ni captación de leads y que el usuario pueda continuar con la siguiente herramienta útil.']},
'metodologia':{title:'Metodología',intro:'Cada calculadora separa lógica matemática, interfaz, contenido, fuentes y metadatos.',body:['Las funciones matemáticas son módulos puros y testeables. La mayoría de las calculadoras procesa los valores íntegramente en el navegador y Calcula tu Casa no recibe ni almacena esos valores. En Solar, preparar la URL no comunica datos a PVGIS; solo cuando el usuario abre voluntariamente la consulta oficial, el navegador envía directamente al JRC/PVGIS las coordenadas y parámetros necesarios. El JSON que el usuario pega o selecciona después se procesa localmente en su navegador.','Los parámetros que son hipótesis del simulador se identifican como tales. No se presentan precios, potencias, factores de simultaneidad ni coeficientes orientativos como universales.','Las herramientas muestran fórmula, ejemplo, interpretación, limitaciones, fuentes, fecha de revisión y versión metodológica. Cuando existe incertidumbre relevante se prefiere un rango a una cifra falsamente precisa.','Expansión revisada el 6 de octubre de 2026. Las doce calculadoras cuentan con pruebas automatizadas y la QA del repositorio registra qué se ha ejecutado realmente.']},
'fuentes':{title:'Fuentes',intro:'Priorizamos documentación técnica identificable y distinguimos fuentes externas de hipótesis propias.',body:['Para transmitancia y ventilación se referencia documentación oficial del Código Técnico de la Edificación. Para punto de rocío se documenta Magnus/Sonntag; para frigorías, Daikin/ASHRAE; para factura, BOE; y para producción solar, PVGIS/JRC.','Los cálculos básicos de energía relacionan potencia, tiempo y energía; el precio del kWh lo introduce el usuario.','Una fuente enlazada no convierte automáticamente una estimación simplificada en una verificación reglamentaria: cada herramienta explica sus límites.']},
'politica-editorial':{title:'Política editorial',intro:'Publicamos una herramienta cuando su lógica puede explicarse, probarse y mantenerse.',body:['No inventamos expertos, autores, estudios, estadísticas, reseñas, ratings ni credenciales. No ocultamos supuestos detrás de una cifra precisa.','Las correcciones relevantes deben actualizar la versión metodológica y la documentación de QA. El contenido SEO debe responder a una pregunta real y no rellenar la página con repeticiones de palabras clave.','La publicidad futura se mantendrá separada de formularios, botones y resultados; en esta V1 solo existen espacios reservados sin código publicitario.']},
'contacto':{title:'Contacto',intro:email?'Puedes comunicar errores o sugerencias mediante el correo configurado para el proyecto.':'El canal de contacto público todavía no está configurado.',body:[email?'Al informar de un error, indica la calculadora, los valores utilizados y el resultado esperado. Evita datos personales innecesarios.':'El correo de contacto todavía no está configurado en este entorno.']},
'aviso-legal':{title:'Aviso legal',intro:'Identificación del titular y condiciones generales de uso de Calcula tu Casa.',body:[legalIdentity,'Calcula tu Casa ofrece herramientas y contenidos informativos sobre hogar, energía, climatización, aislamiento, solar, reformas y ahorro. Los resultados son estimaciones y no sustituyen proyectos técnicos, certificaciones, mediciones, diagnósticos ni presupuestos profesionales cuando estos sean necesarios.','El usuario debe utilizar el sitio de forma lícita y no alterar su funcionamiento. Las fórmulas, fuentes, hipótesis y limitaciones se muestran para facilitar una interpretación responsable de los resultados.','Los enlaces a organismos públicos, documentación técnica y otros sitios externos se ofrecen como referencia. Calcula tu Casa no controla ni responde de los contenidos, disponibilidad o cambios de esos sitios externos.','Para comunicar errores, incidencias o cuestiones relacionadas con el sitio puede utilizarse el correo indicado en esta página.']},
'privacidad':{title:'Política de privacidad',intro:'Información sobre el tratamiento de datos personales y sobre qué datos no recibe Calcula tu Casa.',body:[legalReady?`Responsable del tratamiento: ${owner}, NIF ${nif}, domicilio ${address}. Contacto para cuestiones de privacidad: ${email}.`:'Los datos del responsable todavía no están completos en este entorno.','La mayoría de las calculadoras procesa los valores íntegramente en el navegador y Calcula tu Casa no recibe ni almacena esos valores de cálculo. En la calculadora Solar, preparar la consulta no envía datos a PVGIS/JRC; solo cuando el usuario abre voluntariamente la consulta oficial, su navegador comunica directamente a ese servicio las coordenadas y parámetros necesarios. El JSON que se pega o selecciona después se procesa localmente.','Si el usuario escribe por correo electrónico, se tratarán la dirección de correo, el contenido del mensaje y los datos que voluntariamente incluya con la finalidad de responder a la consulta. La base jurídica es la comunicación iniciada voluntariamente por el usuario y, cuando proceda, el interés legítimo en atender incidencias y mantener el servicio. Se recomienda no enviar datos personales innecesarios.','El proveedor de alojamiento puede tratar datos técnicos y registros necesarios para operar, proteger y diagnosticar el servicio. No se venden datos personales ni se ceden con fines comerciales propios. Podrán existir comunicaciones a proveedores necesarios para prestar el servicio o cuando exista una obligación legal.','La publicidad de Google AdSense y cualquier analítica no están activas actualmente. Antes de cargar tecnologías publicitarias no necesarias para usuarios del EEE se configurará una plataforma de gestión del consentimiento adecuada y se actualizará esta política conforme a la configuración real.','Los datos de contacto se conservarán durante el tiempo necesario para atender la comunicación y, posteriormente, durante los plazos que puedan resultar exigibles. El usuario puede solicitar acceso, rectificación, supresión, oposición, limitación o portabilidad cuando proceda escribiendo al correo de contacto. También puede presentar una reclamación ante la Agencia Española de Protección de Datos (AEPD).']},
'cookies':{title:'Política de cookies',intro:'Situación actual de cookies y tecnologías similares en Calcula tu Casa.',body:['Las calculadoras esenciales funcionan sin cookies publicitarias y actualmente no se carga el script de Google AdSense ni Google Analytics. Los espacios publicitarios visibles en el código del proyecto son únicamente reservas de diseño y no sirven anuncios.','La web contiene una metaetiqueta de verificación de cuenta de AdSense utilizada para acreditar la propiedad del sitio. Esa metaetiqueta no carga por sí sola el script publicitario de AdSense.','El proveedor de alojamiento puede utilizar mecanismos técnicos estrictamente necesarios para seguridad, entrega y funcionamiento del servicio según su configuración.','Antes de activar publicidad o tecnologías no necesarias para usuarios del Espacio Económico Europeo se configurará una plataforma de gestión del consentimiento adecuada. El usuario deberá poder aceptar, rechazar y configurar sus elecciones, así como modificarlas posteriormente.','Cuando se active publicidad, analítica u otras tecnologías no necesarias, esta política se actualizará para identificar proveedores, finalidades, categorías y duraciones efectivamente utilizadas.']}
};
const page=pages[info];const pending=['contacto','aviso-legal','privacidad','cookies'].includes(info);
---
<Base title={page.title} description={page.intro} noindex={pending}><article class="article hero"><p class="eyebrow">TRANSPARENCIA DEL PROYECTO</p><h1>{page.title}</h1><p class="lead">{page.intro}</p>{page.body.map(p=><p>{p}</p>)}{info==='sobre-nosotros'&&<p><a class="link" href="/calculadoras/">Ver las {tools.length} calculadoras →</a></p>}{info==='contacto'&&email&&<div data-contact-actions><p><strong>Correo:</strong> <a class="link" href={`mailto:${email}`}>{email}</a></p><div class="actions"><a class="button" href={`mailto:${email}`}>Escribir correo</a><button class="button secondary" type="button" data-copy-email={email}>Copiar dirección</button></div><p class="help" data-copy-status aria-live="polite"></p></div>}<p class="help">Última revisión: 6 de octubre de 2026.</p></article></Base>
<script>
  const copyButton=document.querySelector('[data-copy-email]');
  const copyStatus=document.querySelector('[data-copy-status]');
  if(copyButton instanceof HTMLButtonElement){
    copyButton.addEventListener('click',async()=>{
      const email=copyButton.dataset.copyEmail||'';
      if(!email)return;
      try{
        if(navigator.clipboard?.writeText){
          await navigator.clipboard.writeText(email);
        }else{
          const textarea=document.createElement('textarea');
          textarea.value=email;
          textarea.setAttribute('readonly','');
          textarea.style.position='absolute';
          textarea.style.left='-9999px';
          document.body.append(textarea);
          textarea.select();
          document.execCommand('copy');
          textarea.remove();
        }
        if(copyStatus)copyStatus.textContent='Dirección copiada al portapapeles.';
        copyButton.textContent='Copiada';
        window.setTimeout(()=>{
          copyButton.textContent='Copiar dirección';
          if(copyStatus)copyStatus.textContent='';
        },2500);
      }catch{
        if(copyStatus)copyStatus.textContent='No se ha podido copiar automáticamente. Selecciona la dirección mostrada arriba.';
      }
    });
  }
</script>