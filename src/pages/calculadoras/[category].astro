---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import {tools} from '../../lib/catalog.mjs';
export function getStaticPaths(){return [{params:{category:'energia'},props:{name:'Energía'}},{params:{category:'climatizacion'},props:{name:'Climatización'}}];}
const selected=tools.filter(t=>t.categorySlug===Astro.params.category);
---
<Base title={`Calculadoras de ${Astro.props.name.toLowerCase()}`} description={`Calcula el consumo y el coste de ${Astro.props.name.toLowerCase()} en tu hogar.`}><section class="hero"><p class="eyebrow">CALCULADORAS</p><h1>{Astro.props.name}</h1><p class="lead">Introduce tus datos y compara escenarios de uso con fórmulas transparentes.</p></section><div class="grid">{selected.map(tool=><ToolCard tool={tool}/>)}</div></Base>
