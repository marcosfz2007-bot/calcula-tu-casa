---
import '../styles/global.css';
const { title, description, noindex = false, schema } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const privatePage = noindex || !Astro.site;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Calcula tu casa</title><meta name="description" content={description}/><meta name="theme-color" content="#244d3b"/>{canonical && <link rel="canonical" href={canonical}/>}{privatePage && <meta name="robots" content="noindex, follow"/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical && <meta property="og:url" content={canonical}/>}<link rel="icon" href="/favicon.svg"/>{schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')}/>}</head><body><a href="#contenido" class="skip">Saltar al contenido</a><header class="header"><div class="wrap"><a class="brand" href="/">⌂ calcula<span>tu</span>casa<span>.</span></a><nav class="nav" aria-label="Principal"><a href="/calculadoras/">Calculadoras</a><a href="/metodologia/">Cómo calculamos</a></nav></div></header><main id="contenido" class="wrap"><slot/></main><footer class="footer"><div class="wrap"><a class="brand" href="/">Calcula tu casa.</a><p>Entiende tu consumo. Decide con números.</p><div class="footer-links">{[['sobre-nosotros','Sobre el proyecto'],['metodologia','Metodología'],['fuentes','Fuentes'],['politica-editorial','Política editorial'],['contacto','Contacto'],['aviso-legal','Aviso legal'],['privacidad','Privacidad'],['cookies','Configurar privacidad y cookies']].map(([path,label])=><a href={`/${path}/`}>{label}</a>)}</div><p>Herramientas orientativas · Cálculos locales en tu navegador · Versión inicial 0.1</p></div></footer></body></html>
