---
import '../styles/global.css';
const {title,description,noindex=false,schema}=Astro.props;
const canonical=Astro.site?new URL(Astro.url.pathname,Astro.site).href:undefined;
const privatePage=noindex||!Astro.site;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | Calcula tu casa</title><meta name="description" content={description}/><meta name="theme-color" content="#244d3b"/><meta name="google-adsense-account" content="ca-pub-2485158097356751"/>{canonical&&<link rel="canonical" href={canonical}/>} {privatePage&&<meta name="robots" content="noindex, follow"/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical&&<meta property="og:url" content={canonical}/>}<link rel="icon" href="/favicon.svg"/>{Astro.site&&<link rel="sitemap" href="/sitemap-index.xml"/>}{schema&&<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/>}</head><body><a href="#contenido" class="skip">Saltar al contenido</a><header class="header"><div class="wrap header-row"><a class="brand" href="/">⌂ calcula<span>tu</span>casa<span>.</span></a><button class="menu-button" type="button" aria-expanded="false" aria-controls="main-nav"><span aria-hidden="true">☰</span><span class="sr-only">Abrir menú</span></button><nav class="nav" id="main-nav" aria-label="Principal"><a href="/calculadoras/">Calculadoras</a><a href="/energia/">Energía</a><a href="/climatizacion/">Climatización</a><a href="/aislamiento/">Aislamiento</a><a href="/solar/">Solar</a><a href="/reformas/">Reformas</a></nav></div></header><main id="contenido" class="wrap"><slot/></main><footer class="footer"><div class="wrap"><a class="brand" href="/">Calcula tu casa.</a><p>Calcula primero. Decide después.</p><div class="footer-links">{[['sobre-nosotros','Sobre el proyecto'],['metodologia','Metodología'],['fuentes','Fuentes'],['politica-editorial','Política editorial'],['contacto','Contacto'],['aviso-legal','Aviso legal'],['privacidad','Privacidad'],['cookies','Configurar privacidad y cookies']].map(([path,label])=><a href={`/${path}/`}>{label}</a>)}</div><p>Herramientas orientativas · Cálculos locales · Metodologías y limitaciones visibles</p></div></footer><script is:inline>
const button=document.querySelector('.menu-button'),nav=document.querySelector('#main-nav'),label=button?.querySelector('.sr-only');
if(button&&nav){const setState=(open)=>{button.setAttribute('aria-expanded',String(open));nav.classList.toggle('open',open);if(label)label.textContent=open?'Cerrar menú':'Abrir menú';};const close=(restoreFocus=false)=>{const wasOpen=button.getAttribute('aria-expanded')==='true';setState(false);if(restoreFocus&&wasOpen)button.focus();};button.addEventListener('click',()=>setState(button.getAttribute('aria-expanded')!=='true'));nav.addEventListener('click',e=>{if(e.target.closest('a'))close(false);});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&button.getAttribute('aria-expanded')==='true')close(true);});}
</script></body></html>