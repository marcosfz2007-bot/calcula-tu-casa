---
import CategoryIcon from './CategoryIcon.astro';
import {getToolPresentation} from '../lib/presentation.mjs';
const {tool}=Astro.props;
const presentation=getToolPresentation(tool);
---
<a class={'card tool-card category-'+tool.categorySlug} href={'/'+tool.path+'/'} data-tool-card data-search={(presentation.question+' '+presentation.result+' '+tool.short+' '+tool.category+' '+tool.description+' '+(tool.keywords||[]).join(' ')+' '+tool.path).toLowerCase()}>
  <span class="tool-card-top">
    <span class="tool-icon"><CategoryIcon slug={tool.categorySlug} size={24}/></span>
    <span class="tool-category">{tool.category}</span>
  </span>
  <h3>{presentation.question}</h3>
  <p class="muted">{tool.description}</p>
  <span class="tool-result-label"><strong>Obtendrás:</strong> {presentation.result}</span>
  <span class="link">Calcular <span aria-hidden="true">→</span></span>
</a>