---
const {tool}=Astro.props;
---
<a class="card tool-card" href={`/${tool.path}/`} data-tool-card data-search={`${tool.short} ${tool.category} ${tool.description} ${(tool.keywords||[]).join(' ')} ${tool.path}`.toLowerCase()}><span class="tool-icon" aria-hidden="true">{tool.icon}</span><p class="eyebrow">{tool.category}</p><h3>{tool.short}</h3><p class="muted">{tool.description}</p><span class="link">Abrir calculadora →</span></a>
