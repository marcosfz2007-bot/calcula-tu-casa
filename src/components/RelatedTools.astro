---
import ToolCard from './ToolCard.astro';
import {toolByPath} from '../lib/catalog.mjs';
const {paths=[]}=Astro.props;
const selected=paths.map(p=>toolByPath.get(p)).filter(Boolean);
---
<section class="section related-tools">
  <div class="section-head"><div><p class="eyebrow">SIGUIENTE PASO</p><h2>También puede interesarte</h2></div><p class="muted">Continúa con una herramienta relacionada cuando responda a la siguiente decisión que quieres tomar.</p></div>
  <div class="grid">{selected.map(tool=><ToolCard tool={tool}/>)}</div>
</section>
