---
import Base from '../layouts/Base.astro';
import ToolCard from './ToolCard.astro';
import {tools} from '../lib/catalog.mjs';
const {category}=Astro.props;
const current=tools.filter(t=>t.categorySlug===category.slug);
---
<Base title={`Calculadoras de ${category.name.toLowerCase()}`} description={category.description} noindex={category.indexable===false}><section class="hero"><p class="eyebrow">CALCULADORAS · {category.name}</p><h1>{category.name}</h1><p class="lead">{category.description}</p></section>{current.length>0?<section class="section"><h2>Herramientas disponibles</h2><div class="grid">{current.map(tool=><ToolCard tool={tool}/>)}</div></section>:<section class="card"><h2>Herramientas en preparación</h2><p>Esta categoría forma parte de la arquitectura V1, pero todavía no publica una calculadora sin metodología suficientemente verificada.</p></section>}<section class="section"><h2>Próximas herramientas</h2><ul>{category.future.map(item=><li>{item}</li>)}</ul><p class="muted">Se muestran como futuras; no enlazamos rutas que todavía no existen.</p></section><p><a class="link" href="/calculadoras/">Ver las 8 calculadoras de la V1 →</a></p></Base>