---
import Base from '../layouts/Base.astro';
import ToolCard from './ToolCard.astro';
import CategoryIcon from './CategoryIcon.astro';
import {tools,categories} from '../lib/catalog.mjs';
const {category}=Astro.props;
const current=tools.filter(t=>t.categorySlug===category.slug);
---
<Base title={'Calculadoras de '+category.name.toLowerCase()} description={category.description} noindex={category.indexable===false}>
  <section class={'hero hub-hero hub-'+category.slug}>
    <div class="hub-title-row">
      <span class="hub-category-icon"><CategoryIcon slug={category.slug}/></span>
      <div><p class="eyebrow">CALCULADORAS · {category.name}</p><h1>{category.name}</h1></div>
    </div>
    <p class="lead">{category.description}</p>
    <div class="hub-meta"><strong>{current.length}</strong><span>herramientas publicadas</span><span>·</span><span>Sin registro</span><span>·</span><span>Metodología visible</span></div>
    <div class="hub-links">{categories.map(c=><a href={'/'+c.slug+'/'} aria-current={c.slug===category.slug?'page':undefined}>{c.name}</a>)}</div>
  </section>
  {current.length>0?
    <section class="section">
      <div class="section-head"><div><p class="eyebrow">ELIGE TU SIGUIENTE DECISIÓN</p><h2>Herramientas de {category.name.toLowerCase()}</h2></div><p class="muted">Cada calculadora explica qué dato obtendrás, qué hipótesis utiliza y dónde están sus límites.</p></div>
      <div class="grid">{current.map(tool=><ToolCard tool={tool}/>)}</div>
    </section>
    :<section class="card"><h2>Herramientas en preparación</h2><p>Esta categoría forma parte de la arquitectura, pero todavía no publica una calculadora sin metodología suficientemente verificada.</p></section>}
  {category.future.length>0&&<section class="section"><div class="card future-card"><p class="eyebrow">EN ESTUDIO</p><h2>Próximas preguntas a resolver</h2><ul>{category.future.map(item=><li>{item}</li>)}</ul><p class="muted">Se muestran como futuras; no enlazamos rutas que todavía no existen.</p></div></section>}
  <p><a class="link" href="/calculadoras/">Ver las {tools.length} calculadoras →</a></p>
</Base>