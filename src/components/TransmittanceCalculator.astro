---
import SegmentedControl from './SegmentedControl.astro';
const {tool}=Astro.props;
---
<div class="calculator" data-calculator data-kind="transmittance">
<form class="card calc-form" novalidate>
  <p class="form-kicker">CAPAS DEL CERRAMIENTO</p><h2>Composición térmica</h2>
  <SegmentedControl name="surface" legend="Dirección del flujo" selected="wall" options={[['wall','Vertical'],['roof','Cubierta'],['floor','Suelo']]}/>
  <p class="help mt-5">Vertical: flujo horizontal · cubierta: flujo ascendente · suelo: flujo descendente.</p>
  <div class="dynamic-list" data-layers>
    <div class="dynamic-row"><input name="layerName" value="Aislamiento" aria-label="Nombre de la capa"/><label>Espesor <span class="input-wrap"><input name="thicknessMm" value="80" inputmode="decimal"/><span>mm</span></span></label><label>λ <span class="input-wrap"><input name="lambda" value="0,04" inputmode="decimal"/><span>W/(m·K)</span></span></label><button class="button tertiary" type="button" data-remove-row>Eliminar</button></div>
  </div>
  <button class="button tertiary" type="button" data-add-layer>Añadir capa</button>
  <p class="error" data-form-error aria-live="polite"></p>
  <div class="actions"><button class="button" type="submit">Calcular transmitancia</button><button class="button secondary" type="reset">Restablecer</button></div>
</form>
<section class="card result result-kind-transmittance"><p class="eyebrow">TU ESTIMACIÓN</p><h2>Transmitancia térmica</h2><div id="result-output" aria-live="polite"><p>Introduce las capas y calcula.</p></div></section>
</div>
<script>import '../lib/calculator-ui.mjs';</script>