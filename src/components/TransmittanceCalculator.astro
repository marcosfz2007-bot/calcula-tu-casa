---
import ResultPanel from './ResultPanel.astro';
import SegmentedControl from './SegmentedControl.astro';
const {tool}=Astro.props;
---
<div class="calculator" data-calculator data-kind="transmittance">
<form class="card calculator-form" novalidate>
<div class="calculator-form-heading"><p class="eyebrow">TUS DATOS</p><h2>Capas del cerramiento</h2><p>Añade cada material con su espesor y conductividad.</p></div>
<fieldset class="calc-group"><legend><span>01</span>Dirección y capas</legend>
<SegmentedControl name="surface" label="Dirección del flujo" value="wall" options={[['wall','Vertical'],['roof','Cubierta'],['floor','Suelo']]}/>
<div data-layers class="dynamic-list"><div class="dynamic-row"><input name="layerName" value="Capa 1" aria-label="Nombre de la capa"/><label>Espesor <span class="input-wrap"><input name="thicknessMm" value="100" inputmode="decimal"/><span>mm</span></span></label><label>λ <span class="input-wrap"><input name="lambda" value="0,040" inputmode="decimal"/><span>W/(m·K)</span></span></label><button type="button" class="button tertiary" data-remove-row>Eliminar</button></div></div>
<button type="button" class="button secondary" data-add-layer>Añadir capa</button>
</fieldset>
<fieldset class="calc-group"><legend><span>02</span>Objetivo opcional</legend><div class="fields"><div><label for="targetU">U objetivo (opcional)</label><div class="input-wrap"><input id="targetU" name="targetU" value="0,30" inputmode="decimal"/><span>W/m²K</span></div></div><div><label for="extraLambda">λ del aislamiento adicional</label><div class="input-wrap"><input id="extraLambda" name="extraLambda" value="0,040" inputmode="decimal"/><span>W/(m·K)</span></div></div></div></fieldset>
<p class="error" data-form-error></p><div class="actions"><button class="button" type="submit">Calcular R y U</button><button class="button secondary" type="reset">Restablecer</button></div>
</form>
<ResultPanel title="R y U"><div id="result-output" aria-live="polite"><p>Revisa las capas y pulsa «Calcular R y U».</p></div></ResultPanel>
</div>
<script>import '../lib/calculator-ui.mjs';</script>