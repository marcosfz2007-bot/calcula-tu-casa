---
const {tool}=Astro.props;
---
<div class="calculator" data-calculator data-kind="transmittance"><form class="card" novalidate><h2>Capas del cerramiento</h2><label for="surface">Dirección del flujo</label><select id="surface" name="surface"><option value="wall">Vertical · flujo horizontal</option><option value="roof">Cubierta · flujo ascendente</option><option value="floor">Suelo · flujo descendente</option></select><div data-layers class="dynamic-list"><div class="dynamic-row"><input name="layerName" value="Capa 1" aria-label="Nombre de la capa"/><label>Espesor <span class="input-wrap"><input name="thicknessMm" value="100" inputmode="decimal"/><span>mm</span></span></label><label>λ <span class="input-wrap"><input name="lambda" value="0,040" inputmode="decimal"/><span>W/(m·K)</span></span></label><button type="button" class="button tertiary" data-remove-row>Eliminar</button></div></div><button type="button" class="button secondary" data-add-layer>Añadir capa</button><div class="fields mt-5"><div><label for="targetU">U objetivo (opcional)</label><div class="input-wrap"><input id="targetU" name="targetU" value="0,30" inputmode="decimal"/><span>W/m²K</span></div></div><div><label for="extraLambda">λ del aislamiento adicional</label><div class="input-wrap"><input id="extraLambda" name="extraLambda" value="0,040" inputmode="decimal"/><span>W/(m·K)</span></div></div></div><p class="error" data-form-error></p><div class="actions"><button class="button" type="submit">Calcular R y U</button><button class="button secondary" type="reset">Restablecer</button></div></form><section class="card result"><p class="eyebrow">TU ESTIMACIÓN</p><h2>R y U</h2><div id="result-output" aria-live="polite"><p>Revisa las capas y pulsa «Calcular R y U».</p></div></section></div><script>import '../lib/calculator-ui.mjs';</script>
