---
import {getToolPresentation} from '../lib/presentation.mjs';
const {tools=[]}=Astro.props;
const quickPaths=['climatizacion/calculadora-frigorias','energia/simulador-factura-electrica','reformas/presupuesto-reforma-integral','solar/numero-placas-solares'];
const quick=quickPaths.map(path=>tools.find(tool=>tool.path===path)).filter(Boolean);
---
<div class="hero-search" data-hero-search>
  <label for="hero-tool-search">¿Qué quieres calcular?</label>
  <div class="hero-search-input">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6.8"/><path d="m16.2 16.2 4.2 4.2"/></svg>
    <input id="hero-tool-search" type="search" autocomplete="off" placeholder="Ej.: frigorías, factura, pintura, placas solares…" aria-describedby="hero-search-status"/>
  </div>
  <p class="sr-only" id="hero-search-status" data-hero-search-status aria-live="polite">{tools.length} herramientas disponibles</p>
  <div class="hero-search-results" data-hero-search-results hidden>
    {tools.map(tool=>{const p=getToolPresentation(tool);return <a href={'/'+tool.path+'/'} data-hero-result data-search={(tool.short+' '+p.question+' '+tool.category+' '+tool.description+' '+(tool.keywords||[]).join(' ')).toLowerCase()}><span><small>{tool.category}</small><strong>{p.question}</strong></span><span aria-hidden="true">→</span></a>})}
  </div>
  <p class="hero-search-empty" data-hero-search-empty hidden>No hay coincidencias. Prueba con otro término o abre el directorio completo.</p>
  <div class="hero-quick"><span>Accesos rápidos:</span>{quick.map(tool=><a href={'/'+tool.path+'/'}>{tool.short}</a>)}</div>
  <a class="hero-directory-link" href="/calculadoras/">Explorar las {tools.length} calculadoras →</a>
</div>
<script>
import {normalizeSearchText} from '../lib/search.mjs';
document.querySelectorAll('[data-hero-search]').forEach(root=>{
 if(root.dataset.ready==='true')return;root.dataset.ready='true';
 const input=root.querySelector('input[type=search]'),results=root.querySelector('[data-hero-search-results]'),items=[...root.querySelectorAll('[data-hero-result]')],empty=root.querySelector('[data-hero-search-empty]'),status=root.querySelector('[data-hero-search-status]');
 if(!input||!results)return;
 input.addEventListener('input',()=>{
   const q=normalizeSearchText(input.value);let visible=0;
   items.forEach(item=>{const show=Boolean(q)&&normalizeSearchText(item.dataset.search).includes(q);item.hidden=!show;if(show)visible++;});
   results.hidden=!q; if(empty)empty.hidden=!q||visible>0;
   if(status)status.textContent=q?(visible+' herramienta'+(visible===1?'':'s')+' encontrada'+(visible===1?'':'s')):(items.length+' herramientas disponibles');
 });
});
</script>