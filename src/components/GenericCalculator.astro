---
import ResultPanel from './ResultPanel.astro';
import {getFormGroups} from '../lib/presentation.mjs';
const {tool}=Astro.props;
const groups=getFormGroups(tool);
const fieldMap=new Map(tool.fields.map(field=>[field[0],field]));
---
<noscript><p class="no-js">Activa JavaScript para utilizar la calculadora. La metodología permanece visible sin JavaScript.</p></noscript>
<div class="calculator" data-calculator data-kind={tool.kind}>
  <form class="card calculator-form" novalidate>
    <div class="calculator-form-heading"><p class="eyebrow">TUS DATOS</p><h2>Introduce tus datos</h2><p>Completa únicamente las variables necesarias para esta estimación.</p></div>
    {groups.map((group,index)=><fieldset class="calc-group">
      <legend><span>{String(index+1).padStart(2,'0')}</span>{group.title}</legend>
      <div class="fields">{group.keys.map(key=>{const [fieldKey,label,unit,value]=fieldMap.get(key);return <div class="calc-field"><label for={fieldKey}>{label}</label><div class="input-wrap"><input id={fieldKey} name={fieldKey} type="text" inputmode="decimal" value={value} autocomplete="off" aria-describedby={fieldKey+'-error format-help'}/><span>{unit}</span></div><span class="error" id={fieldKey+'-error'}></span></div>})}</div>
    </fieldset>)}
    <p class="help mt-5" id="format-help">Admite coma o punto decimal. Los valores iniciales son ejemplos editables, no recomendaciones universales.</p>
    <div class="actions"><button class="button" type="submit">Calcular</button><button class="button secondary" type="reset">Restablecer</button></div>
  </form>
  <ResultPanel title="Resultado" id="result-title"><div id="result-output" aria-live="polite" aria-atomic="true"><p>Revisa los datos y pulsa «Calcular».</p></div></ResultPanel>
</div>
<script>import '../lib/calculator-ui.mjs';</script>