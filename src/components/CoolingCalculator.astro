---
import ResultPanel from './ResultPanel.astro';
import SegmentedControl from './SegmentedControl.astro';
---
<div class="calculator" data-calculator data-kind="cooling">
<form class="card calculator-form" novalidate>
<div class="calculator-form-heading"><p class="eyebrow">TUS DATOS</p><h2>Datos de la estancia</h2><p>Describe la geometría y las condiciones térmicas del espacio.</p></div>
<fieldset class="calc-group"><legend><span>01</span>Estancia y cargas</legend><div class="fields">
<div class="calc-field"><label for="area">Superficie</label><div class="input-wrap"><input id="area" name="area" value="30" inputmode="decimal" aria-describedby="area-error"/><span>m²</span></div><span class="error" id="area-error"></span></div>
<div class="calc-field"><label for="height">Altura</label><div class="input-wrap"><input id="height" name="height" value="2,5" inputmode="decimal" aria-describedby="height-error"/><span>m</span></div><span class="error" id="height-error"></span></div>
<div class="calc-field"><label for="glass">Superficie acristalada</label><div class="input-wrap"><input id="glass" name="glass" value="5" inputmode="decimal" aria-describedby="glass-error"/><span>m²</span></div><span class="error" id="glass-error"></span></div>
<div class="calc-field"><label for="people">Personas habituales</label><div class="input-wrap"><input id="people" name="people" value="2" inputmode="numeric" aria-describedby="people-error"/><span>personas</span></div><span class="error" id="people-error"></span></div>
<div class="calc-field"><label for="internalW">Cargas internas relevantes</label><div class="input-wrap"><input id="internalW" name="internalW" value="200" inputmode="decimal" aria-describedby="internalW-error"/><span>W</span></div><span class="error" id="internalW-error"></span></div>
</div></fieldset>
<fieldset class="calc-group"><legend><span>02</span>Características térmicas</legend>
<SegmentedControl name="climate" label="Zona climática orientativa" value="warm" options={[['mild','Suave'],['warm','Cálida'],['hot','Muy cálida']]}/>
<SegmentedControl name="orientation" label="Orientación principal" value="S" options={[['N','Norte'],['E','Este'],['S','Sur'],['O','Oeste']]}/>
<SegmentedControl name="insulation" label="Aislamiento" value="average" options={[['good','Bueno'],['average','Medio'],['poor','Deficiente']]}/>
</fieldset>
<p class="help">La zona no es una zona climática oficial del CTE: selecciona un escenario orientativo. Las cargas internas deben ser las que quieras sumar (equipos, iluminación u otras fuentes de calor).</p>
<div class="actions"><button class="button" type="submit">Calcular potencia</button><button class="button secondary" type="reset">Restablecer</button></div>
</form>
<ResultPanel title="Potencia de refrigeración"><div id="result-output" aria-live="polite"><p>Revisa los datos y pulsa «Calcular potencia».</p></div></ResultPanel>
</div>
<script>import '../lib/calculator-ui.mjs';</script>